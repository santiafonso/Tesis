# --- Python ---
__pycache__/
*.pyc
*.pyo
*.swp
venv/
venv
.venv/

# --- DIP / restoration outputs ---
results/
results_*/
result_*/
GRIS/
logs/
*.npy
*.npz

# --- Archived run outputs / old result dirs (kept locally, never committed) ---
archive/

# --- KMC artifacts / large simulation data ---
kmc_fast
*.o
vmd-*.xyz
CS-*.xyz
datos-*.dat
parametros.dat
kmc_*points*.txt
kmc_launched_points.txt

# --- Reference papers (kept locally, not in the repo) ---
*.pdf

# --- Generated images, but keep input assets under data/ and the figures
# that ship inside each presentaciones/presentacionN_DD_MM/ ---
*.png
*.jpg
*.jpeg
!data/**
!presentaciones/**

# --- LibreOffice lock files (left behind when a .pptx is open) ---
.~lock.*

# --- autoexp: corridas del loop de experimentacion (score.json/panel.png se miran ahi) ---
autoexp/runs/

# --- autoexp/kmc: log del loop automatico y pruebas de DIP (locales) ---
autoexp/kmc/*/auto.log
autoexp/kmc/*/dip_prueba*/
autoexp/kmc/arranque.log
autoexp/kmc/dip_prueba*/

# --- autoexp/kmc: árboles crudos de corridas (estado.txt, kmc.out, datos por réplica); lo que vale queda
# resumido en resultados_*.csv / res_*.csv. Y la copia de estados que trae tendencia/todos_finales.py ---
autoexp/kmc/**/runs/
autoexp/kmc/tendencia/kmc/

# --- `!presentaciones/**` de arriba vuelve a incluir los caches de Python de los generadores ---
presentaciones/**/__pycache__/

# --- editor ---
.vscode/

# --- investigacion_soc0: binarios compilados y carpetas de corridas de prueba (los datos-*.dat ya se ignoran) ---
autoexp/kmc/investigacion_soc0/kmc_ef
autoexp/kmc/investigacion_soc0/kmc_ef_rand
autoexp/kmc/investigacion_soc0/kmc_orig
autoexp/kmc/investigacion_soc0/kmc_refresco
autoexp/kmc/investigacion_soc0/version_vieja/kmc_vieja
autoexp/kmc/investigacion_soc0/run_*/
autoexp/kmc/investigacion_soc0/comparacion_ef/r[0-9]*/
